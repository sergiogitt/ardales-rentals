---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { properties } from '../../data/properties';
import { whatsappLink } from '../../data/properties';

export async function getStaticPaths() {
  return properties.map(p => ({
    params: { slug: p.slug },
    props: { property: p },
  }));
}

const { property } = Astro.props;
const waMsg = `Hola! Me interesa reservar *${property.name}*. ¿Podéis decirme la disponibilidad y precio? Gracias 🙏`;
const waUrl = whatsappLink(waMsg);
---

<Layout
  title={`${property.name} — Alquiler en Ardales, Málaga | Isabel Apartamentos`}
  description={`${property.tagline}. ${property.guests} huéspedes · ${property.bedrooms} habitaciones · Desde ${property.price}€/noche. Reserva directa sin comisiones.`}
>
  <Nav />

  <!-- HERO -->
  <section class="prop-hero" style={`--prop-color: ${property.color}`}>
    <div class="prop-hero__bg">
      {property.images?.length ? (
        <>
          <div class="hero-carousel" aria-label={`Fotos de ${property.name}`}>
            {property.images.map((src, i) => (
              <img
                class={`hero-slide ${i === 0 ? 'active' : ''}`}
                src={src}
                alt={`${property.name} — foto ${i + 1}`}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            ))}

            {property.images.length > 1 && (
              <>
                <button class="hero-btn prev" type="button" aria-label="Foto anterior">‹</button>
                <button class="hero-btn next" type="button" aria-label="Foto siguiente">›</button>

                <div class="hero-dots" aria-hidden="true">
                  {property.images.map((_, i) => (
                    <button
                      class={`hero-dot ${i === 0 ? 'active' : ''}`}
                      type="button"
                      data-dot={i}
                      tabindex="-1"
                    />
                  ))}
                </div>
              </>
            )}
          </div>

          <script is:inline>
            (function () {
              const root = document.currentScript?.previousElementSibling;
              if (!root || !root.classList.contains('hero-carousel')) return;

              const slides = root.querySelectorAll('.hero-slide');
              if (slides.length < 2) return;

              const prev = root.querySelector('.hero-btn.prev');
              const next = root.querySelector('.hero-btn.next');
              const dots = root.querySelectorAll('.hero-dot');

              let current = 0;

              const show = (i) => {
                slides.forEach(s => s.classList.remove('active'));
                dots.forEach(d => d.classList.remove('active'));

                slides[i].classList.add('active');
                dots[i]?.classList.add('active');
                current = i;
              };

              const onPrev = () => show((current - 1 + slides.length) % slides.length);
              const onNext = () => show((current + 1) % slides.length);

              prev?.addEventListener('click', onPrev);
              next?.addEventListener('click', onNext);

              dots.forEach((d) => {
                d.addEventListener('click', (e) => {
                  const idx = Number(e.currentTarget?.getAttribute('data-dot'));
                  if (!Number.isNaN(idx)) show(idx);
                });
              });
            })();
          </script>
        </>
      ) : (
        <span class="prop-hero__emoji">{property.emoji}</span>
      )}
    </div>

    <div class="prop-hero__overlay"></div>

    <div class="prop-hero__content">
      <a href="/propiedades" class="prop-hero__back">← Todas las propiedades</a>
      <p class="prop-hero__location">📍 {property.location}</p>
      <h1 class="prop-hero__title">{property.name}</h1>
      <p class="prop-hero__tagline">{property.tagline}</p>
      <div class="prop-hero__specs">
        <span>👥 {property.guests} huéspedes</span>
        <span>🛏 {property.bedrooms} habitaciones</span>
        <span>🚿 {property.bathrooms} baños</span>
      </div>
    </div>
  </section>

  <!-- MAIN CONTENT -->
  <div class="prop-layout">
    <main class="prop-main">

      <!-- DESCRIPTION -->
      <section class="prop-section">
        <h2 class="prop-section__title">Sobre esta propiedad</h2>
        <div class="prop-description">
          {property.description.split('\n\n').map(para => (
            <p>{para}</p>
          ))}
        </div>
      </section>

      <!-- FEATURES -->
      <section class="prop-section">
        <h2 class="prop-section__title">Qué incluye</h2>
        <ul class="prop-features">
          {property.features.map(f => (
            <li class="prop-features__item">
              <span class="prop-features__check" style={`color: ${property.color}`}>✓</span>
              {f}
            </li>
          ))}
        </ul>
      </section>

      <!-- LOCATION -->
      <section class="prop-section">
      <h2 class="prop-section__title">Ubicación</h2>

      <div class="prop-map">
        <iframe
          src={property.googleMap}
          width="100%"
          height="350"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

      <div class="prop-map-info">
        <p>📍 {property.location}</p>
        <p>Ardales, Málaga, Andalucía, España</p>
        <small>Se proporcionan instrucciones exactas tras la reserva</small>
      </div>
    </section>

    </main>

    <!-- SIDEBAR -->
    <aside class="prop-sidebar">
      <div class="prop-booking" style={`--prop-color: ${property.color}`}>
        <div class="prop-booking__price">
          <span class="prop-booking__amount">desde {property.price}€</span>
          <span class="prop-booking__unit">/noche</span>
        </div>

        <div class="prop-booking__specs">
          <div><strong>{property.guests}</strong><span>huéspedes máx.</span></div>
          <div><strong>{property.bedrooms}</strong><span>habitaciones</span></div>
          <div><strong>{property.bathrooms}</strong><span>baños</span></div>
        </div>

        <a href={waUrl} class="prop-booking__btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
          </svg>
          Consultar disponibilidad
        </a>

        <p class="prop-booking__note">
          🔒 Reserva directa · Sin comisiones · Mejor precio garantizado
        </p>

        <div class="prop-booking__features">
          <p>✓ Cancelación flexible</p>
          <p>✓ Check-in 16h · Check-out 11h</p>
          <p>✓ Mínimo 2 noches</p>
        </div>
      </div>

      <!-- SEO Keywords block -->
      <div class="prop-tags">
        <p>Alquiler vacacional Ardales · Casa rural Málaga · Turismo rural Andalucía</p>
      </div>
    </aside>
  </div>

  <!-- OTHER PROPERTIES -->
  <section class="other-props">
    <div class="other-props__inner">
      <h2>También te puede interesar</h2>
      <div class="other-props__grid">
        {properties.filter(p => p.slug !== property.slug).map(p => (
          <a href={`/propiedades/${p.slug}`} class="other-card">
            <div class="other-card__image" style={`background: linear-gradient(135deg, ${p.color}, color-mix(in srgb, ${p.color} 60%, #3d2b1f))`}>
              <img class="property-card__emoji" src={p.images[0]}/>
            </div>
            <div class="other-card__body">
              <h3>{p.name}</h3>
              <p>{p.tagline}</p>
              <span class="other-card__price">desde {p.price}€/noche</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* HERO */
  .prop-hero {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .prop-hero__bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--prop-color), color-mix(in srgb, var(--prop-color) 50%, #3d2b1f));
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .prop-hero__emoji {
    font-size: 12rem;
    opacity: 0.25;
    filter: blur(2px);
  }

  /* ✅ HERO CAROUSEL (NEW) */
  .hero-carousel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.03);
    transition: opacity 0.4s ease, transform 0.6s ease;
  }

  .hero-slide.active {
    opacity: 1;
    transform: scale(1);
  }

  .hero-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgba(61,43,31,0.45);
    backdrop-filter: blur(6px);
    transition: background 0.2s, transform 0.2s;
    user-select: none;
  }

  .hero-btn:hover {
    background: rgba(61,43,31,0.65);
    transform: translateY(-50%) scale(1.05);
  }

  .hero-btn.prev { left: 16px; }
  .hero-btn.next { right: 16px; }

  .hero-dots {
    position: absolute;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    gap: 8px;
  }

  .hero-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    border: 0;
    background: rgba(255,255,255,0.45);
    cursor: pointer;
    padding: 0;
  }

  .hero-dot.active {
    background: rgba(255,255,255,0.95);
  }

  .prop-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(61,43,31,0.85) 0%, rgba(61,43,31,0.2) 60%, transparent 100%);
    z-index: 2;
  }

  .prop-hero__content {
    position: relative;
    z-index: 4;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 8rem 2rem 3rem;
    color: var(--white);
  }

  .prop-hero__back {
    display: inline-block;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.6);
    margin-bottom: 1rem;
    transition: color 0.2s;
  }

  .prop-hero__back:hover {
    color: var(--white);
  }

  .prop-hero__location {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    margin-bottom: 0.75rem;
  }

  .prop-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  .prop-hero__tagline {
    font-size: 1.1rem;
    font-weight: 300;
    color: rgba(255,255,255,0.8);
    max-width: 550px;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .prop-hero__specs {
    display: flex;
    gap: 1.5rem;
    font-size: 0.9rem;
    color: rgba(255,255,255,0.75);
    flex-wrap: wrap;
  }

  /* LAYOUT */
  .prop-layout {
    max-width: 1200px;
    margin: 0 auto;
    padding: 4rem 2rem;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 4rem;
    align-items: start;
  }

  /* SECTIONS */
  .prop-section {
    margin-bottom: 3.5rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid rgba(61,43,31,0.08);
  }

  .prop-section:last-child {
    border-bottom: none;
  }

  .prop-section__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--earth);
    margin-bottom: 1.5rem;
  }

  .prop-description p {
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.9;
    color: #5a4a40;
    margin-bottom: 1.25rem;
  }

  /* FEATURES */
  .prop-features {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem 2rem;
  }

  .prop-features__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    font-weight: 300;
    color: var(--earth);
  }

  .prop-features__check {
    font-weight: 600;
    font-size: 1rem;
  }

  /* MAP */
  .prop-map-placeholder {
    background: var(--sand);
    border-radius: 4px;
    padding: 3rem 2rem;
    text-align: center;
    border: 1px dashed rgba(61,43,31,0.15);
  }

  .prop-map-placeholder p {
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--earth);
    margin-bottom: 0.4rem;
  }

  .prop-map-placeholder small {
    font-size: 0.8rem;
    color: var(--stone);
    font-style: italic;
  }

  /* SIDEBAR */
  .prop-sidebar {
    position: sticky;
    top: 6rem;
  }

  .prop-booking {
    background: var(--white);
    border-radius: 4px;
    padding: 2rem;
    box-shadow: 0 4px 30px rgba(61,43,31,0.1);
    margin-bottom: 1rem;
  }

  .prop-booking__price {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(61,43,31,0.08);
  }

  .prop-booking__amount {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--prop-color);
  }

  .prop-booking__unit {
    font-size: 0.9rem;
    color: var(--stone);
  }

  .prop-booking__specs {
    display: flex;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(61,43,31,0.08);
  }

  .prop-booking__specs div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
  }

  .prop-booking__specs strong {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--earth);
  }

  .prop-booking__specs span {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--stone);
  }

  .prop-booking__btn {
    display: block;
    text-align: center;
    background: var(--prop-color);
    color: var(--white);
    padding: 1rem;
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 2px;
    margin-bottom: 1rem;
    transition: opacity 0.2s, transform 0.2s;
  }

  .prop-booking__btn:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .prop-booking__note {
    font-size: 0.78rem;
    color: var(--stone);
    text-align: center;
    margin-bottom: 1.25rem;
    line-height: 1.5;
  }

  .prop-booking__features {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .prop-booking__features p {
    font-size: 0.85rem;
    font-weight: 300;
    color: var(--earth);
  }

  .prop-tags {
    background: var(--sand);
    padding: 1rem;
    border-radius: 4px;
    font-size: 0.72rem;
    color: var(--stone);
    text-align: center;
    line-height: 1.6;
  }

  /* OTHER PROPERTIES */
  .other-props {
    background: var(--sand);
    padding: 5rem 2rem;
  }

  .other-props__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .other-props h2 {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--earth);
    margin-bottom: 2rem;
  }

  .other-props__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .other-card {
    display: flex;
    gap: 1.25rem;
    background: var(--white);
    border-radius: 4px;
    overflow: hidden;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .other-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(61,43,31,0.12);
  }

  .other-card__image {
    width: 100px;
    flex-shrink: 0;
    overflow: hidden; /* ✅ important */
  }
  .other-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;   /* ✅ makes it fill like background */
    display: block;
  }

  .other-card__body {
    padding: 1rem 1rem 1rem 0;
  }

  .other-card__body h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--earth);
    margin-bottom: 0.3rem;
  }

  .other-card__body p {
    font-size: 0.82rem;
    color: var(--stone);
    font-weight: 300;
    margin-bottom: 0.6rem;
    line-height: 1.4;
  }

  .other-card__price {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--terracotta);
  }

  @media (max-width: 900px) {
    .prop-layout {
      grid-template-columns: 1fr;
    }

    .prop-sidebar {
      position: static;
    }

    .prop-features {
      grid-template-columns: 1fr;
    }

    .other-props__grid {
      grid-template-columns: 1fr;
    }
  }
</style>