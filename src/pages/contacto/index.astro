---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { properties } from '../../data/properties';
---

<Layout
  title="Contacto y Reservas | Isabel Apartamentos"
  description="Consulta disponibilidad y reserva tu casa rural en Ardales, Málaga. Reserva directa sin comisiones. Contacta con nosotros por teléfono, email o formulario."
>
  <Nav />

  <section class="contact-hero">
    <div class="contact-hero__inner">
      <p class="eyebrow">Contacto</p>
      <h1>Planifica tu escapada</h1>
      <p>Escríbenos y te respondemos en menos de 24 horas con disponibilidad y precios.</p>
    </div>
  </section>

  <section class="contact-main">
    <div class="contact-main__inner">

      <div class="contact-form-wrap">
        <h2>Envíanos un mensaje</h2>
        <form class="contact-form" name="contact" method="POST" data-netlify="true">
          <div class="field">
            <label for="name">Nombre completo</label>
            <input type="text" id="name" name="name" required placeholder="Tu nombre" />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required placeholder="tu@email.com" />
          </div>
          <div class="field">
            <label for="phone">Teléfono (opcional)</label>
            <input type="tel" id="phone" name="phone" placeholder="+34 600 000 000" />
          </div>
          <div class="field">
            <label for="property">Propiedad de interés</label>
            <select id="property" name="property">
              <option value="">— Seleccionar —</option>
              {properties.map(p => <option value={p.slug}>{p.name}</option>)}
              <option value="any">Sin preferencia</option>
            </select>
          </div>
          <div class="field field--half">
            <div>
              <label for="checkin">Fecha de entrada</label>
              <input type="date" id="checkin" name="checkin" />
            </div>
            <div>
              <label for="checkout">Fecha de salida</label>
              <input type="date" id="checkout" name="checkout" />
            </div>
          </div>
          <div class="field">
            <label for="guests">Número de huéspedes</label>
            <input type="number" id="guests" name="guests" min="1" max="10" placeholder="2" />
          </div>
          <div class="field">
            <label for="message">Mensaje</label>
            <textarea id="message" name="message" rows="5" placeholder="Cuéntanos qué buscas, fechas exactas, o cualquier duda que tengas..."></textarea>
          </div>
          <button type="submit" class="form-submit">Enviar consulta</button>
        </form>
      </div>

      <div class="contact-info">
        <div class="contact-card">
          <h3>Información de contacto</h3>
          <div class="contact-item">
            <span>📧</span>
            <div>
              <strong>Email</strong>
              <a href="mailto:hola@alorarentals.com">hola@alorarentals.com</a>
            </div>
          </div>
          <div class="contact-item">
            <span>📞</span>
            <div>
              <strong>Teléfono</strong>
              <a href="tel:+34600000000">+34 600 000 000</a>
            </div>
          </div>
          <div class="contact-item">
            <span>📍</span>
            <div>
              <strong>Ubicación</strong>
              <p>Ardales, Málaga, Andalucía, España</p>
            </div>
          </div>
          <div class="contact-item">
            <span>🕐</span>
            <div>
              <strong>Horario de atención</strong>
              <p>Lun–Vie: 9h–20h</p>
              <p>Sáb–Dom: 10h–18h</p>
            </div>
          </div>
        </div>

        <div class="contact-policy">
          <h3>Política de reservas</h3>
          <ul>
            <li>✓ Check-in: desde las 16:00h</li>
            <li>✓ Check-out: antes de las 11:00h</li>
            <li>✓ Estancia mínima: 2 noches</li>
            <li>✓ Animales: consultar según propiedad</li>
            <li>✓ No se permiten eventos o fiestas</li>
          </ul>
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>

<style>
  .contact-hero {
    background: var(--sand);
    padding: 10rem 2rem 5rem;
    text-align: center;
  }

  .contact-hero__inner {
    max-width: 600px;
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--terracotta);
    margin-bottom: 1rem;
  }

  .contact-hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    color: var(--earth);
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .contact-hero p {
    font-size: 1.05rem;
    font-weight: 300;
    color: var(--stone);
  }

  .contact-main {
    padding: 5rem 2rem;
  }

  .contact-main__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 4rem;
    align-items: start;
  }

  .contact-form-wrap h2 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--earth);
    margin-bottom: 2rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field--half {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    flex-direction: row;
  }

  .field--half > div {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  label {
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--earth);
  }

  input,
  select,
  textarea {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 300;
    color: var(--earth);
    background: var(--white);
    border: 1px solid rgba(61,43,31,0.15);
    border-radius: 2px;
    padding: 0.75rem 1rem;
    transition: border-color 0.2s;
    outline: none;
    width: 100%;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--terracotta);
  }

  textarea {
    resize: vertical;
  }

  .form-submit {
    background: var(--terracotta);
    color: var(--white);
    border: none;
    padding: 1rem 2rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 2px;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    align-self: flex-start;
  }

  .form-submit:hover {
    background: var(--terracotta-dark);
    transform: translateY(-2px);
  }

  /* CONTACT INFO */
  .contact-card {
    background: var(--white);
    border-radius: 4px;
    padding: 2rem;
    box-shadow: 0 2px 20px rgba(61,43,31,0.07);
    margin-bottom: 1.5rem;
  }

  .contact-card h3,
  .contact-policy h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--earth);
    margin-bottom: 1.25rem;
  }

  .contact-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(61,43,31,0.06);
  }

  .contact-item:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .contact-item span {
    font-size: 1.25rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .contact-item strong {
    display: block;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--stone);
    margin-bottom: 0.2rem;
  }

  .contact-item a,
  .contact-item p {
    font-size: 0.95rem;
    font-weight: 300;
    color: var(--earth);
  }

  .contact-item a:hover {
    color: var(--terracotta);
  }

  .contact-policy {
    background: var(--sand);
    border-radius: 4px;
    padding: 1.75rem;
  }

  .contact-policy ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-policy li {
    font-size: 0.9rem;
    font-weight: 300;
    color: var(--earth);
  }

  @media (max-width: 900px) {
    .contact-main__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .field--half {
      grid-template-columns: 1fr;
    }
  }
</style>
