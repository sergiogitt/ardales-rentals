---
import Carousel from './Carousel.astro';
import { whatsappLink } from '../data/properties';
import withBase from '../utils/base';

export interface Props {
  slug: string;
  name: string;
  tagline: string;
  location: string;
  guests: number;
  bedrooms: number;
  bathrooms: number;
  price: number;
  features: string[];
  images: string[];
  color: string;
  emoji?: string;
}

const { slug, name, tagline, location, guests, bedrooms, bathrooms, price, features, images, color } = Astro.props;

const waMsg = `Hola! Me interesa reservar *${name}*. ¿Podéis decirme la disponibilidad y precio? Gracias 🙏`;
const waUrl = whatsappLink(waMsg);
---

<article class="property-card" style={`--accent: ${color}`}>
  <a href={withBase(`/propiedades/${slug}`)} class="property-card__image-link" aria-label={`Ver fotos de ${name}`}>
    <div class="property-card__carousel">
      <Carousel images={images} name={name} aspectRatio="4/3" id={slug} />
      <div class="property-card__location-badge">{location}</div>
    </div>
  </a>

  <div class="property-card__body">
    <h3 class="property-card__name">
      <a href={withBase(`/propiedades/${slug}`)}>{name}</a>
    </h3>
    <p class="property-card__tagline">{tagline}</p>

    <div class="property-card__specs">
      <span>👥 {guests} huéspedes</span>
      <span>🛏 {bedrooms} hab.</span>
      <span>🚿 {bathrooms} baño{bathrooms > 1 ? 's' : ''}</span>
    </div>

    <ul class="property-card__features">
      {features.slice(0, 3).map(f => <li>{f}</li>)}
    </ul>

    <div class="property-card__footer">
      <div class="property-card__price">
        <span class="property-card__price-num">desde {price}€</span>
        <span class="property-card__price-unit">/noche</span>
      </div>
      <div class="property-card__actions">
        <a href={waUrl} target="_blank" rel="noopener noreferrer" class="property-card__wa" aria-label="Consultar por WhatsApp">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
          </svg>
        </a>
        <a href={withBase(`/propiedades/${slug}`)} class="property-card__cta">
          Ver →
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .property-card {
    background: var(--white);
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 2px 20px rgba(61,43,31,0.06);
    transition: transform 0.35s cubic-bezier(.22,.68,0,1.2), box-shadow 0.35s;
    display: flex;
    flex-direction: column;
  }

  .property-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(61,43,31,0.14);
  }

  .property-card__image-link {
    display: block;
    position: relative;
  }

  .property-card__carousel {
    position: relative;
    border-radius: 4px 4px 0 0;
    overflow: hidden;
  }

  .property-card__location-badge {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    background: rgba(250,247,242,0.92);
    color: var(--earth);
    padding: 0.28rem 0.75rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 2px;
    z-index: 5;
    backdrop-filter: blur(4px);
  }

  .property-card__body {
    padding: 1.4rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .property-card__name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--earth);
    margin-bottom: 0.35rem;
    line-height: 1.2;
  }

  .property-card__name a {
    color: inherit;
    transition: color 0.2s;
  }

  .property-card__name a:hover { color: var(--accent); }

  .property-card__tagline {
    font-size: 0.85rem;
    color: var(--stone);
    margin-bottom: 0.9rem;
    font-weight: 300;
    line-height: 1.5;
  }

  .property-card__specs {
    display: flex;
    gap: 0.85rem;
    margin-bottom: 0.9rem;
    font-size: 0.82rem;
    color: var(--earth);
    flex-wrap: wrap;
  }

  .property-card__features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1.1rem;
    flex: 1;
  }

  .property-card__features li {
    font-size: 0.82rem;
    color: var(--stone);
    padding-left: 1rem;
    position: relative;
    font-weight: 300;
  }

  .property-card__features li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .property-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid rgba(61,43,31,0.08);
    margin-top: auto;
  }

  .property-card__price-num {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent);
  }

  .property-card__price-unit {
    font-size: 0.78rem;
    color: var(--stone);
    margin-left: 0.15rem;
  }

  .property-card__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .property-card__wa {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: #25d366;
    color: #fff;
    border-radius: 50%;
    transition: background 0.2s, transform 0.2s;
    flex-shrink: 0;
  }

  .property-card__wa:hover {
    background: #1da851;
    transform: scale(1.1);
  }

  .property-card__cta {
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.03em;
    padding: 0.4rem 0.8rem;
    border: 1.5px solid var(--accent);
    border-radius: 2px;
    transition: background 0.2s, color 0.2s;
  }

  .property-card__cta:hover {
    background: var(--accent);
    color: #fff;
  }
</style>