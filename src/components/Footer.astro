---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <div class="footer__logo">
        <span class="footer__logo-main">Isabel</span>
        <span class="footer__logo-sub">Apartamentos</span>
      </div>
      <p class="footer__desc">
        Alojamientos rurales auténticos en el corazón de la Axarquía malagueña.
        Vive Andalucía de verdad.
      </p>
    </div>

    <div class="footer__nav">
      <h4>Propiedades</h4>
      <ul>
        <li><a href="/propiedades/casa-del-olivo">Casa del Olivo</a></li>
        <li><a href="/propiedades/cortijo-la-sierra">Cortijo La Sierra</a></li>
        <li><a href="/propiedades/villa-el-limon">Villa El Limón</a></li>
      </ul>
    </div>

    <div class="footer__nav">
      <h4>Información</h4>
      <ul>
        <li><a href="/sobre-ardales">Sobre Ardales</a></li>
        <li><a href="/contacto">Contacto</a></li>
        <li><a href="/politica-de-privacidad">Privacidad</a></li>
      </ul>
    </div>

    <div class="footer__contact">
      <h4>Contacto</h4>
      <p>📍 Ardales, Málaga, España</p>
      <p>📧 <a href="mailto:hola@alorarentals.com">hola@alorarentals.com</a></p>
      <p>📞 <a href="tel:+34600000000">+34 600 000 000</a></p>
    </div>
  </div>

  <div class="footer__bottom">
    <p>© {new Date().getFullYear()} Isabel Apartamentos · Turismo rural en Málaga</p>
    <p class="footer__seo-text">
      Alquiler vacacional en Ardales · Casas rurales Málaga · Turismo Andalucía
    </p>
  </div>
</footer>

<style>
  .footer {
    background: var(--earth);
    color: rgba(245,240,232,0.75);
    padding: 4rem 2rem 0;
  }

  .footer__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(245,240,232,0.1);
  }

  .footer__logo {
    display: flex;
    flex-direction: column;
    margin-bottom: 1rem;
  }

  .footer__logo-main {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--terracotta);
  }

  .footer__logo-sub {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(245,240,232,0.4);
  }

  .footer__desc {
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.7;
  }

  .footer__nav h4,
  .footer__contact h4 {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--sand);
    margin-bottom: 1rem;
  }

  .footer__nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__nav a {
    font-size: 0.9rem;
    font-weight: 300;
    transition: color 0.2s;
  }

  .footer__nav a:hover {
    color: var(--terracotta);
  }

  .footer__contact p {
    font-size: 0.9rem;
    font-weight: 300;
    margin-bottom: 0.4rem;
  }

  .footer__contact a {
    transition: color 0.2s;
  }

  .footer__contact a:hover {
    color: var(--terracotta);
  }

  .footer__bottom {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    opacity: 0.5;
  }

  .footer__seo-text {
    font-size: 0.75rem;
  }

  @media (max-width: 900px) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }

    .footer__bottom {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
</style>
